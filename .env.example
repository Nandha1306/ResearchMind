# ---------------------------------------------------------------------------
# Root .env -- read ONLY by Docker Compose (docker-compose.yml and the optional
# docker-compose.tools.yml). No Node service reads this file; each service has
# its own services/<name>/.env.
#
# Copy to .env only if .env does not exist (cp -n .env.example .env; never copy
# over an existing .env), then fill in EVERY empty value. Compose refuses to
# start while a required value is missing or empty (no default credentials).
#
# Passwords: use URL-safe values (they go into MONGO_URI / REDIS_URL without
# percent-encoding) of at least 16 characters, each generated independently:
#   openssl rand -hex 24
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# MongoDB applies MONGO_ROOT_* and creates the per-service users ONLY when its
# data volume is first initialised. For an existing volume follow
# "Securing an existing installation" in docs/deployment/docker-process.md.
# ---------------------------------------------------------------------------

# MongoDB root (administrator) account. NOT used by any service.
# (Older setups had a MONGO_ROOT_USER line: Compose never read that name.
# Replace it with MONGO_ROOT_USERNAME set to the root user that already exists
# in your MongoDB volume, normally "admin" -- not necessarily the old value.)
# Service passwords below: 16-256 characters of A-Z a-z 0-9 . _ ~ - only
# (openssl rand -hex 24; base64 output with + / = is rejected). Database
# names: A-Z a-z 0-9 _ - only (no "."). An invalid value on a fresh volume
# leaves MongoDB without service users: check `docker compose logs mongodb`.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Redis password (requirepass). Services use
#   REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379
REDIS_PASSWORD=

# One MongoDB user per service, readWrite on its own database only.
# *_DATABASE must equal the database named in that service's MONGO_URI, and
# that MONGO_URI must use this user and password with ?authSource=admin:
#   mongodb://<MONGO_AUTH_USERNAME>:<MONGO_AUTH_PASSWORD>@127.0.0.1:27017/<MONGO_AUTH_DATABASE>?authSource=admin
MONGO_AUTH_USERNAME=researchmind-auth-svc
MONGO_AUTH_PASSWORD=
MONGO_AUTH_DATABASE=researchmind-auth

MONGO_WORKSPACE_USERNAME=researchmind-workspace-svc
MONGO_WORKSPACE_PASSWORD=
MONGO_WORKSPACE_DATABASE=researchmind-workspace

MONGO_DOCUMENT_USERNAME=researchmind-document-svc
MONGO_DOCUMENT_PASSWORD=
MONGO_DOCUMENT_DATABASE=researchmind-document

MONGO_TASK_USERNAME=researchmind-task-svc
MONGO_TASK_PASSWORD=
MONGO_TASK_DATABASE=researchmind-task

MONGO_AI_USERNAME=researchmind-ai-svc
MONGO_AI_PASSWORD=
MONGO_AI_DATABASE=researchmind-ai

# Only for the optional mongo-express UI (docker-compose.tools.yml).
# Do not reuse the defaults "admin" / "pass".
MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=

# Optional host ports (published on 127.0.0.1 only). Defaults shown.
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# MONGO_EXPRESS_HOST_PORT=8081
