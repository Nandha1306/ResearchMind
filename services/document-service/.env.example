PORT=5003

MONGO_URI=mongodb://<user>:<password>@localhost:27017/researchmind-document?authSource=admin

NODE_ENV=development

WORKSPACE_SERVICE_URL=http://localhost:5002
# ai-service base URL: document deletion removes the document's vectors there.
AI_SERVICE_URL=http://localhost:5006

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>

# Shared secret for the service-to-service /internal routes (auth-service:
# users bulk lookup; document-service: embedding claim and status updates;
# ai-service: vector deletion). Must be IDENTICAL in every service that sets
# it. This service checks it at startup (see above). Sent as the
# X-Internal-Token header -- never in a URL, query string, log line, or
# anything reaching the frontend. Internal routes are not exposed by the
# API gateway.
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-hex-32>
