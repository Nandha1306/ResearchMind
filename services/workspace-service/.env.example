PORT=5002

MONGO_URI=mongodb://<user>:<password>@localhost:27017/researchmind-workspace?authSource=admin

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens
# (api-gateway, auth-service, workspace-service, document-service,
# task-service, ai-service). Rotating it invalidates all issued access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>

# Member names/emails for GET /api/workspaces/:id/members are fetched from
# auth-service over the internal API. Without these, members are listed with a
# placeholder name. INTERNAL_SERVICE_TOKEN must match auth-service's value.
# NOTE: unlike JWT_ACCESS_SECRET, this service does NOT check these at startup.
AUTH_SERVICE_URL=http://localhost:5001
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-hex-48>
