PORT=5001
# Interface to listen on (default 127.0.0.1). Set 0.0.0.0 for container or multi-host use.
# HOST=127.0.0.1

# Connect as THIS service's own MongoDB user (readWrite on its own database
# only), never as the root user. User, password and database are the
# MONGO_AUTH_* values of the root .env (see .env.example in the repository root).
MONGO_URI=mongodb://<auth-service-user>:<auth-service-password>@127.0.0.1:27017/researchmind-auth?authSource=admin

# Access tokens cannot be revoked; keep them short (default 5m, SEC-007).
ACCESS_TOKEN_EXPIRES=5m
REFRESH_TOKEN_EXPIRES=7d

# Optional. Window (ms) in which a just-rotated refresh token is rejected WITHOUT
# revoking every session (two tabs refreshing at once). Inside it a replayed
# token is not treated as theft, so keep it short. Default 10000; 0 disables.
# REFRESH_REUSE_GRACE_MS=10000

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens
# (api-gateway, auth-service, workspace-service, document-service,
# task-service, ai-service). Rotating it invalidates all issued access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>

# Signing key for REFRESH tokens. MUST be different from JWT_ACCESS_SECRET (the
# service refuses to start when they are equal), and
# is needed ONLY by auth-service (the sole issuer/verifier of refresh tokens).
# Rotating it invalidates every stored refresh token, forcing re-login.
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-48>

# Shared secret for service-to-service calls (POST /internal/users/bulk, used
# by workspace-service to show member names). Must be the same value in every
# service. REQUIRED: the service refuses to start while it is missing, a
# <placeholder> or weak (the variable name is printed, never the value).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-hex-48>
