PORT=5000
# The gateway listens on every interface by default (HOST=0.0.0.0).
# HOST=0.0.0.0

# Reverse proxies in front of the gateway whose X-Forwarded-For may be trusted:
# off (default), a hop count 1..10, or a comma-separated list of IPs / CIDR
# ranges / loopback, linklocal, uniquelocal. "true" is refused, and so are
# CIDRs wider than /8 (IPv4) or /32 (IPv6), e.g. 0.0.0.0/0 or ::/0.
# TRUST_PROXY=off

# Behind a reverse proxy TRUST_PROXY is REQUIRED: otherwise every user shares
# the proxy's per-IP rate-limit buckets (login, register, and the 60/min auth
# limiter for refresh, /me and logout).

# A silent upstream (no data at all) gets 504 after this many ms (1000..600000).
# GATEWAY_UPSTREAM_IDLE_TIMEOUT_MS=120000

# Browser origins allowed to call the API (CORS), comma-separated exact
# origins (scheme://host[:port], no path). Unset = any http://localhost:<port>
# or http://127.0.0.1:<port> origin (local development only). "*" or a
# malformed entry stops the gateway at startup. SET THIS IN PRODUCTION.
# CORS_ORIGIN=https://app.example.com

# Swagger UI at /api-docs: off unless exactly "true". Leave it off in production.
# API_DOCS_ENABLED=true

AUTH_SERVICE_URL=http://localhost:5001
WORKSPACE_SERVICE_URL=http://localhost:5002
DOCUMENT_SERVICE_URL=http://localhost:5003
TASK_SERVICE_URL=http://localhost:5004
AI_SERVICE_URL=http://localhost:5006

# Backing store for the per-route rate limiters (SEC-002).
# Limits are stored in Redis so they survive a gateway restart and are shared
# across instances. If Redis is unreachable the limiters fail OPEN and log.
# Redis requires a password: REDIS_PASSWORD from the root .env.
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens
# (api-gateway, auth-service, workspace-service, document-service,
# task-service, ai-service). Rotating it invalidates all issued access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>
