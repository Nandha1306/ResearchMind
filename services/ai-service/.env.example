PORT=5006
# Interface to listen on (default 127.0.0.1: reachable from this machine only).
# Set 0.0.0.0 when the gateway runs on another host or in another container.
# HOST=127.0.0.1

# Redis requires a password: REDIS_PASSWORD from the root .env.
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379

# Connect as THIS service's own MongoDB user (readWrite on its own database
# only), never as the root user. User, password and database are the
# MONGO_AI_* values of the root .env (see .env.example in the repository root).
MONGO_URI=mongodb://<ai-service-user>:<ai-service-password>@127.0.0.1:27017/researchmind-ai?authSource=admin

DOCUMENT_SERVICE_URL=http://localhost:5003
WORKSPACE_SERVICE_URL=http://localhost:5002

VOYAGE_API_KEY=<voyage-api-key>
# Must match the model the Pinecone index was built with; changing it requires
# re-indexing every document (retrieval ignores vectors from another model).
# Also the code default.
VOYAGE_MODEL=voyage-3
VOYAGE_EMBEDDING_DIMENSION=1024
# Minimum similarity score (0..1) for a chunk to be used as a source; 0 disables.
# MIN_RELEVANCE_SCORE=0.2

PINECONE_API_KEY=<pinecone-api-key>
PINECONE_INDEX=<pinecone-index-name>

XAI_API_KEY=<xai-or-groq-api-key>
# Optional LLM settings (defaults shown are the code defaults):
# GROQ_API_KEY=<groq-api-key>        # used only when XAI_API_KEY is unset (delete or comment out the XAI_API_KEY line)
# XAI_BASE_URL=                       # default: Groq URL for gsk_ keys, otherwise https://api.x.ai/v1
# XAI_MODEL=                          # default: openai/gpt-oss-120b (Groq key) or grok-4.5
# LLM_REQUEST_TIMEOUT_MS=60000
# LLM_STREAM_IDLE_TIMEOUT_MS=30000

# Optional time limits (integers in ms; an invalid value falls back to the
# default shown, with a warning):
# VOYAGE_DOCUMENT_TIMEOUT_MS=30000    # one document-embedding batch
# VOYAGE_QUERY_TIMEOUT_MS=15000       # one query embedding
# PINECONE_TIMEOUT_MS=20000           # one Pinecone upsert / delete / query
# DOCUMENT_SOURCE_TIMEOUT_MS=30000    # fetching a document's text from document-service
# EMBEDDING_JOB_TIMEOUT_MS=600000     # whole embedding job (watchdog; keep below 15 min)
# SSE_HEARTBEAT_MS=15000              # keep-alive frames on streamed AI answers

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>

# Shared secret for the service-to-service /internal routes (auth-service:
# users bulk lookup; document-service: embedding claim and status updates;
# ai-service: vector deletion). Must be IDENTICAL in every service that sets
# it. This service checks it at startup (see above). Sent as the
# X-Internal-Token header -- never in a URL, query string, log line, or
# anything reaching the frontend. Internal routes are not exposed by the
# API gateway.
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-hex-32>
