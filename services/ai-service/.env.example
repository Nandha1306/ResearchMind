PORT=5006
REDIS_URL=redis://localhost:6379

MONGO_URI=mongodb://<user>:<password>@localhost:27017/researchmind-ai?authSource=admin

DOCUMENT_SERVICE_URL=http://localhost:5003
WORKSPACE_SERVICE_URL=http://localhost:5002

VOYAGE_API_KEY=<voyage-api-key>
# Must match the model the Pinecone index was built with; changing it requires
# re-indexing every document. Also the code default.
VOYAGE_MODEL=voyage-3
VOYAGE_EMBEDDING_DIMENSION=1024

PINECONE_API_KEY=<pinecone-api-key>
PINECONE_INDEX=<pinecone-index-name>

XAI_API_KEY=<xai-or-groq-api-key>

# ---------------------------------------------------------------------------
# SECURITY
#
# Never commit real values. Generate each secret independently:
#   openssl rand -hex 48        (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#
# Services validate these at startup and REFUSE TO BOOT if a secret is
# missing, left as a <placeholder>, shorter than 32 characters, or set to a
# known-insecure value. Only the variable NAME is ever reported, never a value.
# ---------------------------------------------------------------------------

# Shared HS256 signing key for ACCESS tokens.
# Must be IDENTICAL across every service that verifies access tokens.
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-48>

# Shared secret guarding document-service's /internal service-to-service routes
# (PATCH /internal/documents/:id/embedding-status). Must be IDENTICAL in
# document-service and ai-service. Sent as the X-Internal-Token header --
# never in a URL, query string, log line, or anything reaching the frontend.
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-hex-32>
