{
  "openapi": "3.0.0",
  "info": {
    "title": "ResearchMind AI Service API",
    "version": "1.0.0",
    "description": "AI & RAG Semantic Search Service for ResearchMind"
  },
  "servers": [
    {
      "url": "http://localhost:5006",
      "description": "AI Microservice Direct Port"
    },
    {
      "url": "http://localhost:5000",
      "description": "API Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SemanticSearchDto": {
        "type": "object",
        "required": ["workspaceId", "query"],
        "properties": {
          "workspaceId": {
            "type": "string",
            "example": "60d5ecb8b5c9c22b88e1e123"
          },
          "query": {
            "type": "string",
            "example": "Which exercise demonstrates abstraction?"
          },
          "topK": {
            "type": "number",
            "example": 5,
            "default": 5
          }
        }
      },
      "SummarizeMeetingDto": {
        "type": "object",
        "required": ["workspaceId", "text"],
        "properties": {
          "workspaceId": {
            "type": "string",
            "example": "60d5ecb8b5c9c22b88e1e123"
          },
          "text": {
            "type": "string",
            "example": "Meeting date: August 20, 2026. Attendees: Nandha, Priya and Arjun..."
          }
        }
      },
      "MeetingActionItem": {
        "type": "object",
        "properties": {
          "task": { "type": "string", "example": "Run final benchmark comparison" },
          "assignee": { "type": "string", "example": "Arjun" },
          "due": { "type": "string", "example": "2026-08-25" }
        }
      },
      "MeetingSummaryResponse": {
        "type": "object",
        "properties": {
          "meeting_date": { "type": "string", "example": "2026-08-20" },
          "attendees": { "type": "array", "items": { "type": "string" }, "example": ["Nandha", "Priya", "Arjun"] },
          "summary": { "type": "string", "example": "Team reviewed progress and assigned documentation updates." },
          "decisions": { "type": "array", "items": { "type": "string" }, "example": ["Finish task activity implementation"] },
          "action_items": { "type": "array", "items": { "$ref": "#/components/schemas/MeetingActionItem" } },
          "open_questions": { "type": "array", "items": { "type": "string" }, "example": ["Do AI tasks need manual approval?"] },
          "next_meeting": { "type": "string", "example": "2026-08-25" }
        }
      },
      "RetrievedChunkResponse": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "example": "60d5ecb8b5c9c22b88e1e789"
          },
          "workspaceId": {
            "type": "string",
            "example": "60d5ecb8b5c9c22b88e1e123"
          },
          "chunkIndex": {
            "type": "number",
            "example": 0
          },
          "text": {
            "type": "string",
            "example": "Abstraction is the process of hiding internal implementation details..."
          },
          "score": {
            "type": "number",
            "example": 0.892
          },
          "fileType": {
            "type": "string",
            "enum": ["pdf", "docx"],
            "example": "pdf"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "AI service is healthy"
          }
        }
      }
    },
    "/api/ai/summarize-meeting": {
      "post": {
        "summary": "Summarize raw meeting notes into structured summary and action items using Grok LLM",
        "tags": ["AI & Summarizer"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummarizeMeetingDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured meeting summary generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/MeetingSummaryResponse" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation failure" },
          "401": { "description": "Unauthorized - Missing or invalid JWT" },
          "403": { "description": "Forbidden - Not a member of this workspace" },
          "500": { "description": "Unexpected server error" }
        }
      }
    },
    "/api/ai/search": {
      "post": {
        "summary": "Perform semantic search over workspace documents (Retrieval debug endpoint)",
        "tags": ["AI & Search"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SemanticSearchDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retrieved semantically relevant document chunks successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RetrievedChunkResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Not a member of this workspace" }
        }
      }
    },
    "/api/ai/query": {
      "post": {
        "summary": "Execute full end-to-end RAG query with Grok LLM streaming via Server-Sent Events (SSE)",
        "tags": ["AI & Search"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SemanticSearchDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events (SSE) stream containing start, token, sources, done, and error events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "example": "event: start\ndata: {\"query\":\"Which exercise demonstrates abstraction?\"}\n\nevent: token\ndata: {\"text\":\"Exercise\"}\n\nevent: sources\ndata: {\"sources\":[...]}\n\nevent: done\ndata: {\"sessionId\":\"60d5ecb8b5c9c22b88e1e999\"}\n\n"
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Not a member of this workspace" }
        }
      }
    }
  }
}
